PORT=5000
MONGODB_URI=mongodb://localhost:27017/business-card-scanner
NODE_ENV=development

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Client URLs
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# OCR Service (choose one)
# For Tesseract.js (local, free)
OCR_SERVICE=tesseract

# For Google Cloud Vision API (cloud, paid - better accuracy)
# OCR_SERVICE=google-vision
# GOOGLE_CLOUD_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=./path-to-service-account-key.json

# Image Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# OpenAI (used to analyze scanned images: business cards, screenshots, social posts, etc.)
OPENAI_API_KEY=your-openai-api-key-here

# Google Sheets (service account) - each successful scan is appended as a row
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
